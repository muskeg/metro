; Engine configuration file.
; Minimalist Cozy Transit

config_version=5

[application]

config/name="Metro"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.2", "GL Compatibility")
config/icon="res://assets/branding/metro-icon.png"
boot_splash/image="res://assets/branding/metro-splash.png"
boot_splash/bg_color=Color(0.968627, 0.941176, 0.894118, 1)
boot_splash/fullsize=false

[display]

window/size/viewport_width=1180
window/size/viewport_height=740
window/size/window_width_override=1180
window/size/window_height_override=740
window/size/resizable=true
window/size/borderless=false
window/size/min_width=760
window/size/min_height=520
window/vsync/vsync_mode=1

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.20, 0.27, 0.29, 1)

[audio]

general/default_playback_type.web=0
driver/enable_input=false

[internationalization]

locale/translations=PackedStringArray("res://translations/ui.en.translation", "res://translations/ui.fr.translation")
locale/fallback="en"
