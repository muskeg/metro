; Engine configuration file.
; Minimalist Cozy Transit

config_version=5

[application]

config/name="Metro"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.2", "GL Compatibility")

[display]

window/size/viewport_width=1440
window/size/viewport_height=900
window/size/window_width_override=1440
window/size/window_height_override=900
window/size/resizable=true
window/size/borderless=false
window/size/min_width=900
window/size/min_height=600
window/vsync/vsync_mode=1

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.20, 0.27, 0.29, 1)

[audio]

driver/enable_input=false

[internationalization]

locale/translations=PackedStringArray("res://translations/ui.en.translation", "res://translations/ui.fr.translation")
locale/fallback="en"
